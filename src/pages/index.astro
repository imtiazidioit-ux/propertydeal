---
// src/pages/index.astro
// AETHER // Spatial Computing & Edge Infrastructure Landing Page
// Optimized for Astro SSG & Cloudflare Pages (100/100 Google Lighthouse)

const navLinks = [
  { label: "Architecture", href: "#bento" },
  { label: "Pipeline", href: "#how-it-works" },
  { label: "Telemetry", href: "#benchmarks" },
  { label: "Pricing", href: "#cta" },
];

const metrics = [
  { value: "0.38ms", label: "Global P99 Cold Start", detail: "Across 310+ Cloudflare Edge PoPs" },
  { value: "99.999%", label: "Deterministic Uptime SLA", detail: "Multi-region autonomous failover" },
  { value: "100/100", label: "Core Web Vitals Score", detail: "Zero-bundle static edge hydration" },
  { value: "14.2M+", label: "Requests / Second", detail: "Sustained global mesh throughput" },
];

const workflowSteps = [
  {
    step: "01",
    badge: "INGEST & BLUEPRINT",
    title: "Declarative Schema & Spatial Graph Sync",
    description:
      "Connect your repository or design tokens in one command. Aether parses your application topology into an immutable, type-safe spatial graph with zero configuration files.",
    codeTitle: "aether.config.ts",
    codeSnippet: `export default defineAetherConfig({
  runtime: 'cloudflare-edge-v4',
  regions: ['global-anycast'],
  compute: { isolation: 'v8-isolate', memory: '128MB' },
  telemetry: { stream: 'realtime', sampling: 1.0 }
});`,
    metrics: ["Zero-config AST parsing", "Instant TypeScript inference", "Sub-second local emulation"],
  },
  {
    step: "02",
    badge: "NEURAL SYNTHESIS",
    title: "Autonomous Asset & Route Optimization",
    description:
      "Our compiler analyzes user navigation paths and pre-computes static islands, critical CSS boundaries, and edge-cached state snapshots before a single byte hits the network.",
    codeTitle: "compiler-output.log",
    codeSnippet: `[aether:synth] ✓ Analyzed 48 routes in 42ms
[aether:synth] ✓ Pruned 94.2% unused client JS (0 KB shipped)
[aether:synth] ✓ Generated 12 atomic edge worker bundles
[aether:synth] ✓ Cryptographic state hashes verified`,
    metrics: ["Automatic dead-code elimination", "Predictive prefetch matrices", "Brotli-11 edge compression"],
  },
  {
    step: "03",
    badge: "EDGE COMPILATION",
    title: "Global Atomic Propagation in < 300ms",
    description:
      "Deployments bypass traditional container registries. Compiled WebAssembly and V8 isolates propagate atomically across 310+ global edge locations simultaneously.",
    codeTitle: "deployment-manifest.json",
    codeSnippet: `{
  "deploymentId": "dpl_9x8k2m4p1q7v",
  "propagationTimeMs": 264,
  "activeNodes": 312,
  "ssl": "TLSv1.3-Kyber768-PostQuantum",
  "status": "LIVE_IMMUTABLE"
}`,
    metrics: ["Post-quantum TLS 1.3 encryption", "Atomic instant rollbacks", "Zero-downtime blue/green swaps"],
  },
  {
    step: "04",
    badge: "AUTONOMOUS SCALE",
    title: "Self-Healing Telemetry & Infinite Elasticity",
    description:
      "Watch live traffic route around network congestion in real time. Every request is traced at the hardware level without adding a single millisecond of client latency.",
    codeTitle: "live-edge-stream.sh",
    codeSnippet: `GET /api/v2/spatial-sync 200 OK — 0.41ms [PoP: FRA-04]
GET /api/v2/spatial-sync 200 OK — 0.36ms [PoP: NRT-01]
GET /api/v2/spatial-sync 200 OK — 0.39ms [PoP: IAD-09]
[mesh] Auto-scaled isolate pool: 1,400 -> 18,500 instances`,
    metrics: ["Real-time anomaly mitigation", "DDoS absorption at L3/L4/L7", "Per-request cost attribution"],
  },
];
---

<!doctype html>
<html lang="en" class="dark scroll-smooth selection:bg-indigo-500/30 selection:text-indigo-200">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AETHER // Next-Gen Spatial Edge Architecture</title>
    <meta
      name="description"
      content="Deploy deterministic, zero-latency web applications and spatial interfaces at the global edge. Built for engineering teams that demand perfection."
    />
    <meta name="theme-color" content="#030305" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AETHER // Next-Gen Spatial Edge Architecture" />
    <meta
      property="og:description"
      content="Deploy deterministic, zero-latency web applications and spatial interfaces at the global edge."
    />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }

      body {
        font-family: var(--font-sans);
        background-color: #030305;
        color: #f8fafc;
        overflow-x: hidden;
      }

      .font-mono {
        font-family: var(--font-mono);
      }

      /* Subtle architectural grid overlay */
      .bg-grid-pattern {
        background-size: 48px 48px;
        background-image: 
          linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      }

      /* Radial spotlight hover effect for Bento cards */
      .spotlight-card {
        position: relative;
        overflow: hidden;
      }
      .spotlight-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
          600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
          rgba(99, 102, 241, 0.12),
          transparent 40%
        );
        opacity: 0;
        transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
        z-index: 1;
      }
      .spotlight-card:hover::before {
        opacity: 1;
      }

      /* Infinite Seamless Marquee Animation */
      @keyframes marquee {
        0% {
          transform: translateX(0%);
        }
        100% {
          transform: translateX(-50%);
        }
      }
      .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee 36s linear infinite;
      }
      .animate-marquee:hover {
        animation-play-state: paused;
      }

      /* Subtle floating animation for spatial UI widgets */
      @keyframes floatSlow {
        0%, 100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-8px);
        }
      }
      .animate-float {
        animation: floatSlow 6s ease-in-out infinite;
      }
    </style>
  </head>

  <body class="relative min-h-screen bg-[#030305] text-slate-100 antialiased">
    <!-- Ambient Top Aurora Lighting -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute -top-[25%] left-1/2 h-[650px] w-[1100px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-indigo-600/20 via-violet-600/15 to-cyan-500/10 blur-[140px]"
      ></div>
      <div
        class="absolute top-[40%] -right-[15%] h-[500px] w-[500px] rounded-full bg-indigo-500/10 blur-[130px]"
      ></div>
      <div
        class="absolute bottom-[10%] -left-[15%] h-[500px] w-[600px] rounded-full bg-cyan-500/10 blur-[130px]"
      ></div>
    </div>

    <!-- ==========================================
         FLOATING GLASSMORPHIC NAVIGATION
         ========================================== -->
    <header class="fixed top-0 right-0 left-0 z-50 px-4 pt-4 sm:px-6 lg:px-8">
      <nav
        aria-label="Global"
        class="mx-auto flex max-w-7xl items-center justify-between rounded-2xl border border-white/[0.08] bg-[#06070b]/75 px-4 py-3 shadow-[0_20px_50px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-300 hover:border-white/[0.14]"
      >
        <!-- Brand Identity -->
        <a href="#" class="group flex items-center gap-3 focus:outline-none">
          <div
            class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-indigo-400/30 bg-gradient-to-br from-indigo-500/30 via-violet-500/20 to-transparent shadow-[0_0_25px_rgba(99,102,241,0.35)] transition-transform duration-300 group-hover:scale-105"
          >
            <svg class="h-5 w-5 text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2" />
              <polyline points="2 17 12 22 22 17" />
              <polyline points="2 12 12 17 22 12" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-sm font-bold tracking-wider text-white">AETHER</span>
            <span class="font-mono text-[10px] tracking-widest text-indigo-400/90">OS // v4.2</span>
          </div>
        </a>

        <!-- Desktop Links -->
        <div class="hidden items-center gap-1 md:flex">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-lg px-4 py-2 text-sm font-medium text-slate-300/80 transition-all duration-200 hover:bg-white/[0.06] hover:text-white"
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <!-- Right CTA Cluster -->
        <div class="flex items-center gap-3">
          <div class="hidden items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 lg:flex">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span class="font-mono text-[11px] font-medium text-emerald-300">312 PoPs Online</span>
          </div>

          <a
            href="#cta"
            class="group relative inline-flex items-center gap-2 overflow-hidden rounded-xl bg-white px-4 py-2 text-xs font-semibold text-slate-950 shadow-[0_0_25px_rgba(255,255,255,0.25)] transition-all duration-300 hover:scale-[1.03] hover:bg-indigo-50 active:scale-[0.98] sm:text-sm"
          >
            <span>Deploy Edge Node</span>
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="relative z-10">
      <!-- ==========================================
           HERO SECTION: HOOK & SPATIAL PRODUCT SHOWCASE
           ========================================== -->
      <section class="bg-grid-pattern relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28 lg:pt-44">
        <!-- Bottom fade mask for grid -->
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#030305] to-transparent"
        ></div>

        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-4xl text-center">
            <!-- Announcement Pill -->
            <a
              href="#how-it-works"
              class="group mb-8 inline-flex items-center gap-2.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-4 py-1.5 text-xs font-medium text-indigo-200 backdrop-blur-md transition-all duration-300 hover:border-indigo-400/60 hover:bg-indigo-500/20 hover:shadow-[0_0_30px_rgba(99,102,241,0.3)]"
            >
              <span class="rounded-full bg-indigo-500 px-2 py-0.5 font-mono text-[10px] font-bold tracking-wider text-white uppercase">
                New
              </span>
              <span>Introducing Aether Quantum Engine v4.2</span>
              <svg
                class="h-3.5 w-3.5 text-indigo-300 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 16 16"
                fill="none"
              >
                <path
                  d="M6 3L11 8L6 13"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>

            <!-- Cinematic Gradient Display Headline -->
            <h1
              class="bg-gradient-to-b from-white via-white/95 to-slate-400 bg-clip-text text-5xl font-black tracking-tighter text-transparent sm:text-7xl lg:text-8xl lg:leading-[1.02]"
            >
              Architect the future at
              <span
                class="bg-gradient-to-r from-indigo-400 via-violet-300 to-cyan-300 bg-clip-text text-transparent"
              >
                lightspeed.
              </span>
            </h1>

            <!-- Balanced Subheadline -->
            <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-xl sm:leading-relaxed">
              Aether unifies autonomous edge compute, spatial UI orchestration, and cryptographic state sync into a single deterministic platform. Zero cold starts. Zero configuration drift.
            </p>

            <!-- Primary & Secondary CTA Cluster -->
            <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
              <a
                href="#cta"
                class="group relative inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-gradient-to-r from-indigo-500 via-violet-500 to-indigo-600 px-8 py-4 text-base font-semibold text-white shadow-[0_0_50px_-10px_rgba(99,102,241,0.7)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_60px_-5px_rgba(139,92,246,0.85)] active:scale-[0.98] sm:w-auto"
              >
                <span>Start Building Free</span>
                <svg
                  class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>

              <!-- Interactive CLI Copy Button -->
              <button
                id="copy-cli-btn"
                type="button"
                class="group flex w-full items-center justify-between gap-4 rounded-2xl border border-white/[0.1] bg-white/[0.04] px-6 py-4 font-mono text-xs text-slate-300 backdrop-blur-md transition-all duration-300 hover:border-indigo-500/40 hover:bg-white/[0.07] hover:text-white active:scale-[0.98] sm:w-auto sm:text-sm"
              >
                <span class="flex items-center gap-2">
                  <span class="text-indigo-400">$</span>
                  <span>npx create-aether@latest</span>
                </span>
                <span
                  id="copy-cli-status"
                  class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] text-slate-400 transition-colors group-hover:border-indigo-400/30 group-hover:text-indigo-300"
                >
                  Copy
                </span>
              </button>
            </div>
          </div>

          <!-- ==========================================
               CINEMATIC PRODUCT SHOWCASE (SPATIAL OS MOCKUP)
               ========================================== -->
          <div class="relative mx-auto mt-16 max-w-6xl sm:mt-20">
            <!-- Ambient Backlight Glow -->
            <div
              class="pointer-events-none absolute -inset-1 rounded-[28px] bg-gradient-to-r from-indigo-500/30 via-violet-500/25 to-cyan-500/30 opacity-75 blur-2xl"
              aria-hidden="true"
            ></div>

            <!-- Main Glassmorphic Hardware Frame -->
            <div
              class="relative overflow-hidden rounded-[24px] border border-white/[0.12] bg-[#08090f]/90 shadow-[0_30px_100px_rgba(0,0,0,0.85)] backdrop-blur-2xl"
            >
              <!-- Window Top Chrome Bar -->
              <div
                class="flex flex-wrap items-center justify-between gap-4 border-b border-white/[0.08] bg-white/[0.02] px-4 py-3.5 sm:px-6"
              >
                <div class="flex items-center gap-2">
                  <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
                  <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
                  <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
                  <span class="ml-3 hidden font-mono text-xs text-slate-400 sm:inline-block">
                    aether://edge-control-plane.internal
                  </span>
                </div>

                <!-- Interactive View Switcher Tabs -->
                <div class="flex items-center gap-1 rounded-xl border border-white/[0.08] bg-black/40 p-1" role="tablist">
                  <button
                    type="button"
                    data-tab-target="telemetry"
                    class="hero-tab active rounded-lg bg-indigo-500/20 px-3 py-1 font-mono text-xs font-medium text-indigo-300 transition-all"
                  >
                    01. Edge Telemetry
                  </button>
                  <button
                    type="button"
                    data-tab-target="topology"
                    class="hero-tab rounded-lg px-3 py-1 font-mono text-xs font-medium text-slate-400 transition-all hover:text-white"
                  >
                    02. Neural Topology
                  </button>
                  <button
                    type="button"
                    data-tab-target="logs"
                    class="hero-tab rounded-lg px-3 py-1 font-mono text-xs font-medium text-slate-400 transition-all hover:text-white"
                  >
                    03. Live Isolates
                  </button>
                </div>

                <div class="hidden items-center gap-2 font-mono text-xs text-emerald-400 lg:flex">
                  <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                  <span>SYNC: 0.38ms</span>
                </div>
              </div>

              <!-- Window Interior Content Grid -->
              <div class="grid grid-cols-1 lg:grid-cols-12">
                <!-- Left Sidebar Navigation inside Mockup -->
                <div class="border-b border-white/[0.06] bg-white/[0.01] p-5 lg:col-span-3 lg:border-r lg:border-b-0">
                  <div class="font-mono text-[11px] font-semibold tracking-wider text-slate-400 uppercase">
                    Active Clusters
                  </div>
                  <div class="mt-4 space-y-2.5">
                    <div
                      class="flex items-center justify-between rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-2.5"
                    >
                      <div class="flex items-center gap-2.5">
                        <span class="h-2 w-2 rounded-full bg-indigo-400"></span>
                        <span class="text-xs font-semibold text-white">us-east-iad</span>
                      </div>
                      <span class="font-mono text-[11px] text-indigo-300">0.31ms</span>
                    </div>
                    <div
                      class="flex items-center justify-between rounded-xl border border-white/[0.05] bg-white/[0.02] px-3.5 py-2.5 transition-colors hover:border-white/10"
                    >
                      <div class="flex items-center gap-2.5">
                        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                        <span class="text-xs font-medium text-slate-300">eu-central-fra</span>
                      </div>
                      <span class="font-mono text-[11px] text-slate-400">0.42ms</span>
                    </div>
                    <div
                      class="flex items-center justify-between rounded-xl border border-white/[0.05] bg-white/[0.02] px-3.5 py-2.5 transition-colors hover:border-white/10"
                    >
                      <div class="flex items-center gap-2.5">
                        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                        <span class="text-xs font-medium text-slate-300">ap-northeast-nrt</span>
                      </div>
                      <span class="font-mono text-[11px] text-slate-400">0.39ms</span>
                    </div>
                    <div
                      class="flex items-center justify-between rounded-xl border border-white/[0.05] bg-white/[0.02] px-3.5 py-2.5 transition-colors hover:border-white/10"
                    >
                      <div class="flex items-center gap-2.5">
                        <span class="h-2 w-2 rounded-full bg-cyan-400"></span>
                        <span class="text-xs font-medium text-slate-300">ap-southeast-sin</span>
                      </div>
                      <span class="font-mono text-[11px] text-slate-400">0.44ms</span>
                    </div>
                  </div>

                  <!-- Resource Allocation Mini Card -->
                  <div class="mt-6 rounded-xl border border-white/[0.06] bg-black/40 p-4">
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-400">Isolate Memory</span>
                      <span class="font-mono text-indigo-300">18.4 MB / 128 MB</span>
                    </div>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                      <div class="h-full w-[18%] rounded-full bg-gradient-to-r from-indigo-500 to-cyan-400"></div>
                    </div>
                    <div class="mt-3 flex items-center justify-between font-mono text-[11px] text-slate-400">
                      <span>CPU Time: 0.19ms</span>
                      <span class="text-emerald-400">Optimal</span>
                    </div>
                  </div>
                </div>

                <!-- Center/Right Dynamic Interactive Panel -->
                <div class="relative p-6 sm:p-8 lg:col-span-9">
                  <!-- Tab Panel 1: Telemetry (Default) -->
                  <div id="panel-telemetry" class="hero-panel space-y-6">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                      <div>
                        <span class="font-mono text-xs text-indigo-400 uppercase">Real-Time Anycast Stream</span>
                        <h2 class="mt-1 text-xl font-bold text-white sm:text-2xl">
                          Global Edge Throughput & Latency Wave
                        </h2>
                      </div>
                      <div class="flex items-center gap-3">
                        <div class="rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-2 text-right">
                          <div class="font-mono text-[10px] text-slate-400">REQ / SEC</div>
                          <div class="font-mono text-sm font-bold text-white">14,284,910</div>
                        </div>
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-2 text-right">
                          <div class="font-mono text-[10px] text-emerald-300">CACHE HIT</div>
                          <div class="font-mono text-sm font-bold text-emerald-400">99.94%</div>
                        </div>
                      </div>
                    </div>

                    <!-- High-Precision SVG Telemetry Graph -->
                    <div class="relative h-64 w-full overflow-hidden rounded-2xl border border-white/[0.07] bg-black/50 p-4">
                      <svg class="h-full w-full" viewBox="0 0 800 220" preserveAspectRatio="none">
                        <defs>
                          <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#6366F1" stop-opacity="0.45" />
                            <stop offset="60%" stop-color="#06B6D4" stop-opacity="0.1" />
                            <stop offset="100%" stop-color="#06B6D4" stop-opacity="0.0" />
                          </linearGradient>
                          <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0%" stop-color="#818CF8" />
                            <stop offset="50%" stop-color="#C084FC" />
                            <stop offset="100%" stop-color="#22D3EE" />
                          </linearGradient>
                        </defs>
                        <!-- Horizontal Grid Lines -->
