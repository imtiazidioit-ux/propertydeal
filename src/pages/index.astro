    <!-- ==========================================
         ULTRA-LIGHTWEIGHT INTERACTION ENGINE (<1KB)
         ========================================== -->
    <script is:inline>
      // 1. Mouse-tracking radial spotlight for Bento & Workflow cards
      document.querySelectorAll('.spotlight-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
      });

      // 2. Interactive Hero OS Mockup Tabs
      const tabs = document.querySelectorAll('.hero-tab');
      const panels = {
        telemetry: document.getElementById('panel-telemetry'),
        topology: document.getElementById('panel-topology'),
        logs: document.getElementById('panel-logs'),
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-tab-target');
          tabs.forEach((t) => {
            t.classList.remove('bg-indigo-500/20', 'text-indigo-300');
            t.classList.add('text-slate-400');
          });
          tab.classList.add('bg-indigo-500/20', 'text-indigo-300');
          tab.classList.remove('text-slate-400');

          Object.keys(panels).forEach((key) => {
            if (panels[key]) {
              panels[key].classList.toggle('hidden', key !== target);
            }
          });
        });
      });

      // 3. One-Click CLI Copy to Clipboard
      const copyBtn = document.getElementById('copy-cli-btn');
      const copyStatus = document.getElementById('copy-cli-status');
      if (copyBtn && copyStatus) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('npx create-aether@latest');
            copyStatus.textContent = 'Copied!';
            copyStatus.classList.add('text-emerald-300', 'border-emerald-500/40');
            setTimeout(() => {
              copyStatus.textContent = 'Copy';
              copyStatus.classList.remove('text-emerald-300', 'border-emerald-500/40');
            }, 2000);
          } catch {
            copyStatus.textContent = 'Ready';
          }
        });
      }
    </script>
